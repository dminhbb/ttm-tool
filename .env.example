# Copy relevant parts of this into .env (shared defaults) or .env.local (personal, never
# committed — see .gitignore) and fill in real values. Next.js merges both, .env.local wins.

# Which named DB profile src/lib/db.ts should connect with: "local", "aiven" or "supabase".
# Quick-switch this in .env.local to flip between profiles without touching code.
DB_CONNECTION=local

# --- local profile (PC / offline dev) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=ttm_tool
# Alternative to the PG* vars above: a single connection string for the local profile.
# DATABASE_URL_LOCAL=postgres://postgres:PASSWORD@localhost:5432/ttm_tool

# --- aiven profile (Aiven Console → your service → Overview → "Connection information" → Service URI) ---
DATABASE_URL_AIVEN=postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
# Optional: path to the CA cert downloaded from Aiven Console (verifies the TLS chain instead of
# just encrypting the connection). Leave unset to connect with rejectUnauthorized:false.
# PGSSLROOTCERT=./certs/aiven-ca.pem

# --- supabase profile (Supabase Dashboard → your project → Project Settings → Database → Connection string) ---
# Use the "Transaction pooler" URI (port 6543), not the direct connection (port 5432) — the free
# tier's direct-connection limit is very low, while the pooler is built for exactly this kind of
# many-short-lived-connections app usage. Copy it as-is (it already has the right user format,
# e.g. postgres.xxxxxxxxxxxx) and just fill in your database password.
DATABASE_URL_SUPABASE=postgres://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Optional: path to a custom CA cert for the Supabase connection. Leave unset to connect with
# rejectUnauthorized:false (still encrypted, just without chain validation — fine for this profile).
# PGSSLROOTCERT_SUPABASE=./certs/supabase-ca.pem

NODE_ENV=development
