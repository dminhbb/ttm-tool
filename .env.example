# Copy relevant parts of this into .env (shared defaults) or .env.local (personal, never
# committed — see .gitignore) and fill in real values. Next.js merges both, .env.local wins.

# Which named DB profile src/lib/db.ts should connect with: "local" or "aiven".
# Quick-switch this in .env.local to flip between your local Postgres and Aiven without touching code.
DB_CONNECTION=local

# --- local profile (PC / offline dev) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=ttm_tool
# Alternative to the PG* vars above: a single connection string for the local profile.
# DATABASE_URL_LOCAL=postgres://postgres:PASSWORD@localhost:5432/ttm_tool

# --- aiven profile (Aiven Console → your service → Overview → "Connection information" → Service URI) ---
DATABASE_URL_AIVEN=postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
# Optional: path to the CA cert downloaded from Aiven Console (verifies the TLS chain instead of
# just encrypting the connection). Leave unset to connect with rejectUnauthorized:false.
# PGSSLROOTCERT=./certs/aiven-ca.pem

NODE_ENV=development
