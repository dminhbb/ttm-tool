# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.agents
/.claude
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local databases and runtime files
*.sqlite
*.sqlite3
*.db
*.db-journal

# scripts/mask-jira-csv.js's persistent key-mapping state — a literal real-key↔fake-key decoder
# ring, never commit it. Default path; --state points elsewhere it still matches this glob.
scripts/*.jira-key-mask-map.json

# local tooling caches
.turbo/
.swc/
.eslintcache

# editor and operating-system files
.idea/
*.suo
*.user
Thumbs.db

# manual pre-change file snapshots (see AGENTS.md/daily_change_log.md) — a local safety net on top
# of git history, never meant to ship
/backups

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
public/reports/pr-review-ttm-monitor.zip
public/reports/pr-review-ttm-monitor.html
public/docs/product-guide.zip

# ad-hoc pre-change file copies (foo.ts.bak, foo.ts.bak2, ...) — git history is the backup
*.bak
*.bak[0-9]*

# Báo cáo đo đạc của các script design-system (audit-design-debt, audit-token-contrast,
# check-font-vietnamese). Sinh lại được bất cứ lúc nào, không phải artifact cần commit.
/.design-audit

# Font gốc dạng desktop (.otf/.ttf) — KHÔNG commit. Averta Std CY là font thương mại
# (bản licence của Intelligent Design); đưa file nguyên bản lên git là phân phối lại,
# và repo này từng ở trạng thái public. Bản gốc sống ngoài repo tại ../ias-design/fonts,
# `python scripts/build-brand-font.py` sinh ra bộ WOFF2 đã subset.
# NGOẠI LỆ CÓ CHỦ ĐÍCH: src/app/fonts/*.woff2 vẫn được commit vì src/app/layout.tsx nạp
# trực tiếp qua next/font/local — build trên Vercel không có ../ias-design để sinh lại.
*.otf
*.ttf

# File nén đính kèm (mockup.rar…) — trùng nội dung với thư mục nguồn ngay cạnh,
# chỉ làm phình history. Cần gửi ai thì nén lại từ source.
# (Không chặn *.zip: brd/showcase/showcase.zip và public/docs/product-guide.zip
#  đã được track từ trước, chặn thêm chỉ gây nhầm lẫn.)
*.rar
